import std.mathematics_error
import std
import std.random

match random.create(42) {
    Result.Ok(first_rng) => match random.create(42) {
        Result.Ok(second_rng) => match random.uniform(first_rng, 0.0, 1.0) {
            Result.Ok(first_value) => match random.uniform(second_rng, 0.0, 1.0) {
                Result.Ok(second_value) => {
                    std.printf("%d|", first_value == second_value)
                    match random.clone(first_rng) {
                        Result.Ok(clone) => match random.integer(first_rng, 0, 1000000) {
                            Result.Ok(original_next) => match random.integer(clone, 0, 1000000) {
                                Result.Ok(clone_next) => {
                                    std.printf("%d|", original_next == clone_next)
                                    match random.normal(clone, 0.0, 0.0) {
                                        Result.Ok(_) => std.printf("ok"),
                                        Result.Err(_) => std.printf("err")
                                    }
                                },
                                Result.Err(error) => std.printf("%s", mathematics_error.message(error))
                            },
                            Result.Err(error) => std.printf("%s", mathematics_error.message(error))
                        },
                        Result.Err(error) => std.printf("%s", mathematics_error.message(error))
                    }
                },
                Result.Err(error) => std.printf("%s", mathematics_error.message(error))
            },
            Result.Err(error) => std.printf("%s", mathematics_error.message(error))
        },
        Result.Err(error) => std.printf("%s", mathematics_error.message(error))
    },
    Result.Err(error) => std.printf("%s", mathematics_error.message(error))
}
