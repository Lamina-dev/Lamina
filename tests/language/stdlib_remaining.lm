import std.mathematics_error
import std

func code_name(code mathematics_error.MathErrorCode) -> text {
    match code {
        mathematics_error.InvalidArgument => "InvalidArgument",
        _ => "unexpected"
    }
}

let x = std.cas.symbol("x")
let parsed_x = std.cas.parse("x")
std.printf("%s|%d,%d|", std.cas.to_text(x),
    std.cas.structurally_equal(x, parsed_x),
    std.cas.structurally_equal(std.cas.symbol("x"), parsed_x))
match std.math.hypotenuse(3 as expr, 4 as expr) {
    Result.Ok(value) => std.printf("%.1f|", value),
    Result.Err(error) => std.printf("%s", mathematics_error.message(error))
}
match std.math.binary_exponential(3 as expr) {
    Result.Ok(value) => std.printf("%.1f|", value),
    Result.Err(error) => std.printf("%s", mathematics_error.message(error))
}
match std.linalg.matrix([[3.0, 4.0,], [0.0, 0.0,],]) {
    Result.Ok(matrix) => match std.linalg.matrix_norm(matrix) {
        Result.Ok(value) => std.printf("%.1f|", value),
        Result.Err(error) => std.printf("%s", mathematics_error.message(error))
    },
    Result.Err(error) => std.printf("%s", mathematics_error.message(error))
}
match std.cas.raw.differentiate(x, "") {
    Result.Ok(_) => std.printf("%.1f|unexpected", std.int_to_frac(3)),
    Result.Err(error) => std.printf("%.1f|CasError(%s in %s: %s)",
        std.int_to_frac(3), code_name(mathematics_error.code(error)),
        mathematics_error.operation(error), mathematics_error.message(error))
}
