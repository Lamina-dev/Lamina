import std
import std.cas.algebra
import std.cas.equation_solving

sym x, y

let x2_minus_one = std.cas.parse("x^2 - 1")
let x_minus_one = std.cas.parse("x - 1")
let x_plus_one = std.cas.parse("x + 1")

{
    let expected = std.cas.parse("(x - 1)*(x + 1)")
    let factored = algebra.factor(x2_minus_one)
    std.printf("%d|", std.cas.equivalent(factored, expected)
        and not std.cas.structurally_equal(factored, x2_minus_one))
}
{
    let value = std.cas.parse("(x^2 - 1)/(x - 1)")
    let cancelled = algebra.cancel(value)
    std.printf("%d|", std.cas.equivalent(cancelled, x + 1)
        and not std.cas.structurally_equal(cancelled, value))
}
std.printf("%d|", std.cas.structurally_equal(algebra.simplify_trigonometric(
    std.cas.parse("sin(x)^2 + cos(x)^2")), 1 as expr))
{
    let value = std.cas.parse("x*y + x")
    let expected = x*(y + 1)
    let factored = algebra.factor_multivariate(value)
    std.printf("%d|", std.cas.equivalent(factored, expected)
        and not std.cas.structurally_equal(factored, value))
}
std.printf("%d|", std.cas.equivalent(
    algebra.multivariate_greatest_common_divisor(
        std.cas.parse("x*y + x"), std.cas.parse("x*y + x")), x*(y + 1)))

{
    let factors = std.cas.set_to_array(
        algebra.factor_transcendental(std.cas.parse("exp(2*x) - 1"), x))
    let expected = [std.cas.exponential(2*x) - 1]
    std.printf("%d|", std.cas.set_subset(factors, expected)
        and std.cas.set_subset(expected, factors))
}

std.printf("%d|", std.cas.equivalent(
    algebra.polynomial_greatest_common_divisor(
        x2_minus_one, std.cas.parse("x^2 - 2*x + 1")), x - 1))
std.printf("%d|", std.cas.equivalent(
    algebra.polynomial_resultant(x2_minus_one, x_minus_one, "x"), 0 as expr))
std.printf("%d|", equation_solving.ideal_membership(
    std.cas.parse("x + y - 1"), [std.cas.parse("x + y - 1")], ["x", "y"]))

{
    let generators = [
        std.cas.parse("x + y - 1"),
        std.cas.parse("x - y")
    ]
    let basis = std.cas.set_to_array(
        equation_solving.groebner_basis(generators, ["x", "y"]))
    let expected = [
        generators[0],
        generators[1],
        std.cas.parse("2*y - 1")
    ]
    let complete = std.cas.set_subset(basis, expected)
        and std.cas.set_subset(expected, basis)
    let generators_reduce =
        equation_solving.ideal_membership(generators[0], basis, ["x", "y"])
        and equation_solving.ideal_membership(generators[1], basis, ["x", "y"])
    std.printf("%d|", complete and generators_reduce)
}

{
    let value = std.cas.evaluate_real_with(
        std.cas.parse("log(x, 10)"), ["x"], [100])
    let delta = value - 2.0
    let tolerance = std.cas.evaluate_real(std.cas.parse("1/1000000000000"))
    std.printf("%d|", delta >= -tolerance and delta <= tolerance)
}

std.printf("%d|", std.cas.structurally_equal(
    equation_solving.inequality(x2_minus_one, "<", "x"),
    std.cas.parse("x > -1 and x < 1")))
std.printf("%d", std.cas.equivalent(
    equation_solving.rational_inequality(
        x_minus_one, x_plus_one, ">", x), std.cas.parse("x < -1 or x > 1")))
