import std

unit score
unit level = 100<score>

func three_meters() -> num<m> {
    3<m>
}

let length expr = 2<km>
let meters = length as <m>
let raw = length as num
let display = length as scalar
let points expr = 3<level>
let base_points = points as <score>
let unitless expr = 5<1>
let stripped_unitless = unitless as num
let ordinary = 2<km>
let symbolic_length expr = 1<m>
let promoted_identifier = symbolic_length + ordinary
let promoted_call = symbolic_length + three_meters()

std.printf("%s|%s|%s|%s|%s|%s|%s|%s|%d\n",
    std.cas.to_text(length),
    std.cas.to_text(meters),
    std.cas.to_text(raw),
    std.cas.to_text(display),
    std.cas.to_text(base_points),
    std.cas.to_text(stripped_unitless),
    std.cas.to_text(promoted_identifier),
    std.cas.to_text(promoted_call),
    0)
