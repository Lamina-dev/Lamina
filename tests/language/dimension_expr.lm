import std

unit score
unit level = 100<score>

func three_meters() -> num<m> {
    3<m>
}

let length expr = 2<km>
let meters = length as <m>
let raw = length as num
let display = length as scalar
let points expr = 3<level>
let base_points = points as <score>
let unitless expr = 5<1>
let stripped_unitless = unitless as num
let ordinary = 2<km>
let symbolic_length expr = 1<m>
let promoted_identifier = symbolic_length + ordinary
let promoted_call = symbolic_length + three_meters()

std.printf("%d|%d|%d|%d|%d|%d|%d|%d\n",
    std.cas.equivalent(length, 2000<m> as expr)
        and std.cas.equivalent(length as scalar, std.cas.parse("2")),
    std.cas.equivalent(meters, 2000<m> as expr)
        and std.cas.equivalent(meters as scalar, std.cas.parse("2000")),
    std.cas.equivalent(raw, std.cas.parse("2000")),
    std.cas.equivalent(display, std.cas.parse("2")),
    std.cas.equivalent(base_points, 300<score> as expr)
        and std.cas.equivalent(base_points as scalar, std.cas.parse("300")),
    std.cas.equivalent(stripped_unitless, std.cas.parse("5")),
    std.cas.equivalent(promoted_identifier, 2001<m> as expr),
    std.cas.equivalent(promoted_call, 4<m> as expr))
