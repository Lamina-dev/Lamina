import std

func real_error(result Result<real, text>) -> int {
    match result { Result.Ok(_) => 0, Result.Err(_) => 1 }
}

func int_error(result Result<int, text>) -> int {
    match result { Result.Ok(_) => 0, Result.Err(_) => 1 }
}

func vector_error(result Result<vector, text>) -> int {
    match result { Result.Ok(_) => 0, Result.Err(_) => 1 }
}

match std.rng(12345) {
    Result.Ok(first) => match std.rng(12345) {
        Result.Ok(second) => {
            match std.random_normal(first, 10.0, 2.0) {
                Result.Ok(lhs) => match std.random_normal(second, 10.0, 2.0) {
                    Result.Ok(rhs) => std.printf("%d,", lhs == rhs),
                    Result.Err(error) => std.printf("%s", error)
                },
                Result.Err(error) => std.printf("%s", error)
            }
            match std.random_exponential(first, 2.0) {
                Result.Ok(lhs) => match std.random_exponential(second, 2.0) {
                    Result.Ok(rhs) => std.printf("%d,", lhs == rhs),
                    Result.Err(error) => std.printf("%s", error)
                },
                Result.Err(error) => std.printf("%s", error)
            }
            match std.random_vector(first, 4, -1.0, 1.0) {
                Result.Ok(lhs) => match std.random_vector(second, 4, -1.0, 1.0) {
                    Result.Ok(rhs) => std.printf("%d:%lld,", lhs == rhs, std.vector_size(lhs)),
                    Result.Err(error) => std.printf("%s", error)
                },
                Result.Err(error) => std.printf("%s", error)
            }
            match std.random_int(first, -100, 100) {
                Result.Ok(lhs) => match std.random_int(second, -100, 100) {
                    Result.Ok(rhs) => std.printf("%d|", lhs == rhs),
                    Result.Err(error) => std.printf("%s", error)
                },
                Result.Err(error) => std.printf("%s", error)
            }
            match std.rng(12345) {
                Result.Ok(jumped_source) => match std.rng(12345) {
                    Result.Ok(plain_source) => match std.rng_jump(jumped_source) {
                        Result.Ok(jumped) => match std.random_uniform(jumped, 0.0, 1.0) {
                            Result.Ok(jumped_value) => match std.random_uniform(plain_source, 0.0, 1.0) {
                                Result.Ok(plain_value) => std.printf("%d|", jumped_value != plain_value),
                                Result.Err(error) => std.printf("%s", error)
                            },
                            Result.Err(error) => std.printf("%s", error)
                        },
                        Result.Err(error) => std.printf("%s", error)
                    },
                    Result.Err(error) => std.printf("%s", error)
                },
                Result.Err(error) => std.printf("%s", error)
            }
            std.printf("%d,%d,%d,%d,%d",
                real_error(std.random_uniform(first, 1.0, 1.0)),
                real_error(std.random_normal(first, 0.0, 0.0)),
                real_error(std.random_exponential(first, 0.0)),
                int_error(std.random_int(first, 2, 1)),
                vector_error(std.random_vector(first, 0, 0.0, 1.0)))
        },
        Result.Err(error) => std.printf("%s", error)
    },
    Result.Err(error) => std.printf("%s", error)
}
