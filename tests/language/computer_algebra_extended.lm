import std.mathematics_error
import std
import std.complex

sym x
sym fallback

let parsed = std.cas.parse("x^2 + 2*x + 1")
let integral = std.cas.integrate(x, "x")
let limit = std.cas.limit((x^2 - 1) / (x - 1), "x", 1 as expr, "")
let series = std.cas.series(std.cas.exponential(x), "x", 0 as expr, 3)
let trig = std.cas.sine(std.cas.pi() / 2)
let complex_value = std.cas.evaluate_complex(1 + 2 * I)

std.printf("%s|%s|%s|%s|", std.cas.to_text(parsed),
    std.cas.to_text(integral), std.cas.to_text(limit), std.cas.to_text(series))

{
    let value = std.cas.evaluate_real(trig)
    std.printf("%.1f|", value)
}

std.printf("%.1f,%.1f|", std.complex.real_part(complex_value),
    std.complex.imaginary_part(complex_value))

{
    let value = std.cas.equivalent(parsed, (x + 1)^2)
    std.printf("%d|", value)
}

{
    let values = std.cas.solve(x^2 == 1, "x")
let items = std.cas.set_to_array(values)
        std.printf("%s,%s|", std.cas.to_text(items[0]),
            std.cas.to_text(items[1]))
}

{
    let values = std.cas.roots(x^2 - 1, "x")
let items = std.cas.set_to_array(values)
        std.printf("%s,%s", std.cas.to_text(items[0]),
            std.cas.to_text(items[1]))
}
