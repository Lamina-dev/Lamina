import std

let lhs = std.complex(3.0, 4.0)
let rhs = std.complex(1.0, -2.0)
let zero = std.complex(0.0, 0.0)
let same = lhs == std.complex(3.0, 4.0)
let symbolic expr = lhs

match std.complex_add(lhs, rhs) {
    Result.Ok(value) => std.printf("%.1f,%.1f|",
        std.complex_real(value), std.complex_imag(value)),
    Result.Err(error) => std.printf("%s|", error)
}
match std.complex_mul(lhs, rhs) {
    Result.Ok(value) => std.printf("%.1f,%.1f|",
        std.complex_real(value), std.complex_imag(value)),
    Result.Err(error) => std.printf("%s|", error)
}
match std.complex_sub(lhs, rhs) {
    Result.Ok(value) => std.printf("%.1f,%.1f|",
        std.complex_real(value), std.complex_imag(value)),
    Result.Err(error) => std.printf("%s|", error)
}
match std.complex_conj(lhs) {
    Result.Ok(value) => std.printf("%.1f,%.1f|",
        std.complex_real(value), std.complex_imag(value)),
    Result.Err(error) => std.printf("%s|", error)
}
match std.complex_abs(lhs) {
    Result.Ok(value) => std.printf("%.1f|", value),
    Result.Err(error) => std.printf("%s|", error)
}
match std.complex_div(lhs, zero) {
    Result.Ok(_) => std.printf("ok|"),
    Result.Err(_) => std.printf("err|")
}
std.printf("%d|%d\n", same, std.cas_is_ok(symbolic))
