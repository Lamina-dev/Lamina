import std
import std.cas
import std.mathematics_error

sym x

func show(label text, count int, values set<expr>) {
    let items = std.cas.set_to_array(values)
    var index = 0
    std.printf("%s", label)
    loop count {
        std.printf("%s|", std.cas.to_text(items[index]))
        index = index + 1
    }
    std.printf("\n")
}

func show_error(label text, result Result<set<expr>, mathematics_error.MathError>) {
    match result {
        Result.Ok(_) => std.printf("%sunexpected\n", label),
        Result.Err(error) => match mathematics_error.code(error) {
            mathematics_error.InvalidArgument => std.printf("%s!InvalidArgument:%s\n",
                label, mathematics_error.operation(error)),
            _ => std.printf("%sunexpected error\n", label)
        }
    }
}

func show_quadratic(label text, values set<expr>) {
    let items = std.cas.set_to_array(values)
    let first = std.cas.evaluate_real(items[0])
    let second = std.cas.evaluate_real(items[1])
    let first_residual = first*first + 2.0*first - 6.0
    let second_residual = second*second + 2.0*second - 6.0
    let tolerance = std.cas.evaluate_real(std.cas.parse("1/1000000000"))
    std.printf("%s%.6f|%.6f|residuals=%d\n", label, first, second,
        first_residual > -tolerance and first_residual < tolerance
        and second_residual > -tolerance and second_residual < tolerance)
}

show("solve-x2m1:", 2, std.cas.solve(x^2 == 1, "x"))
show("roots-x2m1:", 2, std.cas.roots(x^2 - 1, "x"))
show_quadratic("solve-q:", std.cas.solve(x^2 + 2*x - 6 == 0, "x"))
show_quadratic("roots-q:", std.cas.roots(x^2 + 2*x - 6, "x"))
show_error("solve-neq:", std.cas.raw.solve(x^2 + 1 < 3, "x"))
show("solve-deg5:", 5, std.cas.solve(x^5 - x - 1 == 0, "x"))
show("solve-complex:", 2, std.cas.solve(x^2 + 1 == 0, "x"))
show("roots-repeated:", 1, std.cas.roots((x - 1)^2, "x"))
