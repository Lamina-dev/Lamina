import std
import std.mathematics_error
import std.cas.geometry
import std.cas.symbolic_matrix

let zero = std.cas.parse("0")
let one = std.cas.parse("1")
let two = std.cas.parse("2")
let three = std.cas.parse("3")
sym fallback

{
    let values = geometry.gradient(std.cas.parse("x^2+y^2"), ["x", "y"])
    std.printf("%s,%s|", std.cas.to_text(values[0]), std.cas.to_text(values[1]))
}
{
    let value = geometry.vector_dot([one, two, three], [std.cas.parse("4"), std.cas.parse("5"), std.cas.parse("6")])
    std.printf("%s|", std.cas.to_text(value))
}
{
    let point = geometry.line_plane_intersection(
    [zero, zero, zero], [one, one, one], [one, one, one], three
)
    std.printf("%s,%s,%s|", std.cas.to_text(point[0]), std.cas.to_text(point[1]), std.cas.to_text(point[2]))
}
{
    let metric = symbolic_matrix.from_rows([[one, zero], [zero, one]])
    std.printf("1|")
}
std.printf("1|")
match std.cas.raw.geometry.vector_cross([one, two], [one, two]) {
    Result.Ok(_) => std.printf("bad"),
    Result.Err(_) => std.printf("CasError")
}
