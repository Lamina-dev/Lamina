import std

sym x, y

let expr = x^2 + 1
let derivative = std.cas_diff(expr, "x")
let value = std.cas_evalf(8 as expr)
let rational_expr = 5/2 + x
let complex_expr = x + 2 * I
let neg_expr = -x
let eight expr = 8
let three expr = 3

std.printf("%s\n", std.cas_to_text(expr))
std.printf("%s\n", std.cas_to_text(derivative))
match value {
    Result.Ok(number) => std.printf("%.1f\n", number),
    Result.Err(error) => std.printf("%s\n", error)
}
std.printf("%s\n", std.cas_to_text(rational_expr))
std.printf("%s\n", std.cas_to_text(complex_expr))
std.printf("%s\n", std.cas_to_text(neg_expr))
match std.num_hypot(eight, eight) {
    Result.Ok(number) => std.printf("%.1f\n", number),
    Result.Err(error) => std.printf("%s\n", error)
}
match std.num_log2(eight) {
    Result.Ok(number) => std.printf("%.1f\n", number),
    Result.Err(error) => std.printf("%s\n", error)
}
match std.num_exp2(three) {
    Result.Ok(number) => std.printf("%.1f\n", number),
    Result.Err(error) => std.printf("%s\n", error)
}
