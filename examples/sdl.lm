static "SDL3"

func SDL_Init(s int) -> bool = "SDL_Init"
func SDL_CreateWindow(t text, w int, h int, wflag int) -> cptr = "SDL_CreateWindow"
func SDL_CreateRenderer(win cptr, name int) -> cptr = "SDL_CreateRenderer"
func SDL_Quit() -> null = "SDL_Quit"
func SDL_SetRenderDrawColor(ren cptr, r int, g int, b int, a int) -> null = "SDL_SetRenderDrawColor"
func SDL_RenderClear(ren cptr) -> null = "SDL_RenderClear"
func SDL_RenderPresent(ren cptr) -> null = "SDL_RenderPresent"
func SDL_Delay(ms int) -> null = "SDL_Delay"
func SDL_DestroyRenderer(ren cptr) -> null = "SDL_DestroyRenderer"
func SDL_DestroyWindow(win cptr) -> null = "SDL_DestroyWindow"

if SDL_Init(32) {
    let win = SDL_CreateWindow("Hello SDL3", 640, 480, 0)
    let ren = SDL_CreateRenderer(win, 0)
    SDL_SetRenderDrawColor(ren, 255, 255, 255, 255)
    SDL_RenderClear(ren)
    SDL_RenderPresent(ren)
    SDL_Delay(2000)
    SDL_DestroyRenderer(ren)
    SDL_DestroyWindow(win)
    SDL_Quit()
}