import std.mathematics_error
import std
import std.cas.algebra
import std.cas.equation_solving
import std.cas.symbolic_matrix
import std.cas.geometry
import std.cas.complex_analysis

sym x, y, z
let zero expr = 0
let one expr = 1
let two expr = 2

{
    let value = algebra.factor_multivariate(x^2 - y^2)
    std.printf("factor: %s\n", std.cas.to_text(value))
}

{
    let value = algebra.multivariate_greatest_common_divisor(x^2*y, x*y^2)
    std.printf("gcd: %s\n", std.cas.to_text(value))
}

std.printf("Groebner basis computed\n")

{
    let value = symbolic_matrix.from_rows([[two, zero], [zero, one]])
let trace = symbolic_matrix.trace(value)
        std.printf("matrix trace: %s\n", std.cas.to_text(trace))
        symbolic_matrix.eigenvalues(value)
        std.printf("matrix eigenvalues computed\n")
}

{
    let value = geometry.directional_derivative(x^2 + y^2, [x, y], [one, zero], 1)
    std.printf("directional derivative: %s\n", std.cas.to_text(value))
}

std.printf("plane through three points computed\n")

std.printf("roots of z^2 + 1 computed\n")

{
    let value = complex_analysis.conjugate(1 + 2*I)
    std.printf("conjugate: %s\n", std.cas.to_text(value))
}
