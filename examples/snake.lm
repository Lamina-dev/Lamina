static "snake_sdl"

#  Lamina Snake : 纯图形界面版 (SDL3 渲染)
#  玩法  : 方向键 / WASD 转向, 空格或回车开始
#          吃红色食物变长, 长到 maxlen(90) 获胜
#          撞墙或咬到自己即死, 死后按 R 重新开始, Q/Esc 退出
#  依赖  : 本目录下 libsnake_sdl.so (源码见 snake_sdl.c)
#  运行  : LD_LIBRARY_PATH=examples ./build/lamina examples/snake.lm

func malloc(n int) -> cptr = "malloc"
func snprintf(buf cptr, n int, fmt text, ...) -> int = "snprintf"
func random_real() -> int = "rand"
func srand(seed int) -> null = "srand"

func SDL_Init(s int) -> bool = "SDL_Init"
func SDL_CreateWindow(t text, w int, h int, wflag int) -> cptr = "SDL_CreateWindow"
func SDL_CreateRenderer(win cptr, name int) -> cptr = "SDL_CreateRenderer"
func SDL_SetWindowTitle(win cptr, t cptr) -> null = "SDL_SetWindowTitle"
func SDL_RaiseWindow(win cptr) -> bool = "SDL_RaiseWindow"
func SDL_SetRenderDrawColor(ren cptr, r int, g int, b int, a int) -> null = "SDL_SetRenderDrawColor"
func SDL_RenderClear(ren cptr) -> null = "SDL_RenderClear"
func SDL_RenderPresent(ren cptr) -> null = "SDL_RenderPresent"
func SDL_Delay(ms int) -> null = "SDL_Delay"
func SDL_GetTicks() -> int = "SDL_GetTicks"
func SDL_DestroyRenderer(ren cptr) -> null = "SDL_DestroyRenderer"
func SDL_DestroyWindow(win cptr) -> null = "SDL_DestroyWindow"
func SDL_Quit() -> null = "SDL_Quit"

func snake_key_pressed(sc int) -> bool = "snake_key_pressed"
func snake_quit_pending() -> bool = "snake_quit_pending"
func snake_fill_rect(ren cptr, x int, y int, w int, h int) -> null = "snake_fill_rect"

func settitle(buf cptr, s int, l int) -> int {
    snprintf(buf, 128, "Lamina Snake   score=%lld len=%lld   [Arrows/WASD] [Q quit]", s, l)
}
func setstart(buf cptr) -> int {
    snprintf(buf, 128, "Lamina Snake   press a direction key to start ...")
}
func setover(buf cptr, s int) -> int {
    snprintf(buf, 128, "GAME OVER   score=%lld   [R restart] [Q quit]", s)
}
func setwin(buf cptr, s int) -> int {
    snprintf(buf, 128, "YOU WIN!   score=%lld   [R restart] [Q quit]", s)
}

