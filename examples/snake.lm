        # ---- 方向输入 (每帧读取: 首个方向键同时开始游戏) ----
        if snake_key_pressed(K_UP) or snake_key_pressed(K_W) {
            if diry != 1 {
                dirx = 0
                diry = -1
            }
            started = true
        } else {
            if snake_key_pressed(K_DOWN) or snake_key_pressed(K_S) {
                if diry != -1 {
                    dirx = 0
                    diry = 1
                }
                started = true
            } else {
                if snake_key_pressed(K_LEFT) or snake_key_pressed(K_A) {
                    if dirx != 1 {
                        dirx = -1
                        diry = 0
                    }
                    started = true
                } else {
