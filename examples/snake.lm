    }

    return 0
}

if SDL_Init(4) {
    let win = SDL_CreateWindow("Lamina Snake", 720, 480, 0)
    SDL_RaiseWindow(win)
    let ren = SDL_CreateRenderer(win, 0)
    var tbuf = malloc(128)
    srand(SDL_GetTicks())
    var again = 1
    loop {
        if again == 0 {
            break
        }
        again = play(ren, win, tbuf)
    }
    SDL_DestroyRenderer(ren)
    SDL_DestroyWindow(win)
    SDL_Quit()
}
