{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/strict-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LMX_BUILD_TESTS": "ON",
        "LMCAS_BUILD_TESTS": "ON",
        "LMCAS_BUILD_LMMC_TESTS": "ON",
        "LMX_ENABLE_LTO": "OFF",
        "LMX_FAST_BUILD": "ON",
        "LMX_ENABLE_SANITIZERS": "OFF",
        "LMX_ENABLE_TSAN": "OFF",
        "LMX_ENABLE_CLANG_TIDY": "OFF",
        "LMCAS_LMMP_ASM": "AUTO"
      }
    },
    {
      "name": "strict-debug",
      "displayName": "Strict debug build",
      "inherits": "base",
      "cacheVariables": {
        "LMX_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-asan-ubsan",
      "displayName": "Linux AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "strict-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "LMX_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux ThreadSanitizer",
      "inherits": "strict-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "LMX_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "static-analysis",
      "displayName": "Strict debug with clang-tidy",
      "inherits": "strict-debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "LMX_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "strict-debug",
      "configurePreset": "strict-debug",
      "jobs": 2
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "jobs": 2
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "jobs": 2
    },
    {
      "name": "static-analysis",
      "configurePreset": "static-analysis",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "strict-debug",
      "configurePreset": "strict-debug",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 2, "timeout": 300 },
      "environment": { "RC_PARAMS": "seed=42" }
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 2, "timeout": 300 },
      "environment": {
        "RC_PARAMS": "seed=42",
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 2, "timeout": 300 },
      "environment": {
        "RC_PARAMS": "seed=42",
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    }
  ]
}
