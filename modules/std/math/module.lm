import std.mathematics_error

static "liblamina"

func hypotenuse(x expr, y expr) -> Result<real, mathematics_error.MathError> = "lmx_math_hypot"
func binary_logarithm(x expr) -> Result<real, mathematics_error.MathError> = "lmx_math_log2"
func binary_exponential(x expr) -> Result<real, mathematics_error.MathError> = "lmx_math_exp2"

func pi() -> Result<real, mathematics_error.MathError> = "lmx_math_pi"
func euler_number() -> Result<real, mathematics_error.MathError> = "lmx_math_e"
func golden_ratio() -> Result<real, mathematics_error.MathError> = "lmx_math_phi"
func constants() -> array<text> = "lmx_math_constants"
func constant(name text) -> Result<real, mathematics_error.MathError> = "lmx_math_constant"
func constant_unit(name text) -> Result<text, mathematics_error.MathError> = "lmx_math_constant_unit"

func sine(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_sin"
func cosine(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_cos"
func tangent(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_tan"
func inverse_sine(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_asin"
func inverse_cosine(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_acos"
func inverse_tangent(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_atan"
func square_root(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_sqrt"
func exponential(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_exp"
func natural_logarithm(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_ln"
func logarithm(value frac, base frac) -> Result<real, mathematics_error.MathError> = "lmx_math_log_base"
func common_logarithm(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_log10"
func power(base frac, exponent frac) -> Result<real, mathematics_error.MathError> = "lmx_math_pow"
func absolute_value(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_abs"
func floor(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_floor"
func ceil(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_ceil"
func round(value frac) -> Result<real, mathematics_error.MathError> = "lmx_math_round"
func clamp(value frac, lower frac, upper frac) -> Result<real, mathematics_error.MathError> = "lmx_math_clamp"
