import std.mathematics_error

static "liblamina"

func mean(value vector) -> Result<real, mathematics_error.MathError> = "lmx_stats_mean"
func variance(value vector) -> Result<real, mathematics_error.MathError> = "lmx_stats_variance"
func variance_population(value vector) -> Result<real, mathematics_error.MathError> = "lmx_stats_variance_population"
func standard_deviation(value vector) -> Result<real, mathematics_error.MathError> = "lmx_stats_stddev"
func stddev_population(value vector) -> Result<real, mathematics_error.MathError> = "lmx_stats_stddev_population"
func median(value vector) -> Result<real, mathematics_error.MathError> = "lmx_stats_median"
func quantile(value vector, p frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_quantile"
func covariance(lhs vector, rhs vector) -> Result<real, mathematics_error.MathError> = "lmx_stats_covariance"
func correlation(lhs vector, rhs vector) -> Result<real, mathematics_error.MathError> = "lmx_stats_correlation"
func histogram(value vector, bins int) -> Result<table, mathematics_error.MathError> = "lmx_stats_histogram"
func factorial(n int) -> Result<real, mathematics_error.MathError> = "lmx_stats_factorial"
func combinations(n int, r int) -> Result<real, mathematics_error.MathError> = "lmx_stats_combinations"
func permutations(n int, r int) -> Result<real, mathematics_error.MathError> = "lmx_stats_permutations"
func column_mean(value matrix) -> Result<vector, mathematics_error.MathError> = "lmx_stats_column_mean"
func covariance_matrix_sample(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_stats_covariance_matrix_sample"
func covariance_matrix_population(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_stats_covariance_matrix_population"
func correlation_matrix_sample(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_stats_correlation_matrix_sample"
func correlation_matrix_population(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_stats_correlation_matrix_population"
func normal_probability_density(x frac, mean frac, stddev frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_normal_pdf"
func normal_cumulative_distribution(x frac, mean frac, stddev frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_normal_cdf"
func normal_quantile(p frac, mean frac, stddev frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_normal_quantile"
func student_t_probability_density(x frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_t_pdf"
func student_t_cumulative_distribution(x frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_t_cdf"
func t_quantile(p frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_t_quantile"
func chi_squared_probability_density(x frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_chi2_pdf"
func chi_squared_cumulative_distribution(x frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_chi2_cdf"
func chi2_quantile(p frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_chi2_quantile"
func fisher_f_probability_density(x frac, df1 frac, df2 frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_f_pdf"
func fisher_f_cumulative_distribution(x frac, df1 frac, df2 frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_f_cdf"
func f_quantile(p frac, df1 frac, df2 frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_f_quantile"
func gamma_pdf(x frac, shape frac, scale frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_gamma_pdf"
func gamma_cdf(x frac, shape frac, scale frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_gamma_cdf"
func gamma_quantile(p frac, shape frac, scale frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_gamma_quantile"
func beta_pdf(x frac, alpha frac, beta frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_beta_pdf"
func beta_cdf(x frac, alpha frac, beta frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_beta_cdf"
func beta_quantile(p frac, alpha frac, beta frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_beta_quantile"
func binomial_probability_mass(k int, n int, p frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_binomial_pmf"
func binomial_cumulative_distribution(k int, n int, p frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_binomial_cdf"
func poisson_probability_mass(k int, lambda frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_poisson_pmf"
func poisson_cumulative_distribution(k int, lambda frac) -> Result<real, mathematics_error.MathError> = "lmx_stats_poisson_cdf"
