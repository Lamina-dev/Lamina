import std.mathematics_error

static "liblamina"

func mean(value vector) -> Result<real, mathematics_error.MathError> = "lmx_statistics_mean"
func variance(value vector) -> Result<real, mathematics_error.MathError> = "lmx_statistics_variance"
func variance_population(value vector) -> Result<real, mathematics_error.MathError> = "lmx_statistics_variance_population"
func standard_deviation(value vector) -> Result<real, mathematics_error.MathError> = "lmx_statistics_standard_deviation"
func stddev_population(value vector) -> Result<real, mathematics_error.MathError> = "lmx_statistics_stddev_population"
func median(value vector) -> Result<real, mathematics_error.MathError> = "lmx_statistics_median"
func quantile(value vector, p frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_quantile"
func covariance(lhs vector, rhs vector) -> Result<real, mathematics_error.MathError> = "lmx_statistics_covariance"
func correlation(lhs vector, rhs vector) -> Result<real, mathematics_error.MathError> = "lmx_statistics_correlation"
func histogram(value vector, bins int) -> Result<table, mathematics_error.MathError> = "lmx_statistics_histogram"
func factorial(n int) -> Result<real, mathematics_error.MathError> = "lmx_statistics_factorial"
func combinations(n int, r int) -> Result<real, mathematics_error.MathError> = "lmx_statistics_combinations"
func permutations(n int, r int) -> Result<real, mathematics_error.MathError> = "lmx_statistics_permutations"
func column_mean(value matrix) -> Result<vector, mathematics_error.MathError> = "lmx_statistics_column_mean"
func covariance_matrix_sample(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_statistics_covariance_matrix_sample"
func covariance_matrix_population(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_statistics_covariance_matrix_population"
func correlation_matrix_sample(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_statistics_correlation_matrix_sample"
func correlation_matrix_population(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_statistics_correlation_matrix_population"
func normal_probability_density(x frac, mean frac, stddev frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_normal_probability_density"
func normal_cumulative_distribution(x frac, mean frac, stddev frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_normal_cumulative_distribution"
func normal_quantile(p frac, mean frac, stddev frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_normal_quantile"
func student_t_probability_density(x frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_student_t_probability_density"
func student_t_cumulative_distribution(x frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_student_t_cumulative_distribution"
func t_quantile(p frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_t_quantile"
func chi_squared_probability_density(x frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_chi_squared_probability_density"
func chi_squared_cumulative_distribution(x frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_chi_squared_cumulative_distribution"
func chi2_quantile(p frac, df frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_chi2_quantile"
func fisher_f_probability_density(x frac, df1 frac, df2 frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_fisher_f_probability_density"
func fisher_f_cumulative_distribution(x frac, df1 frac, df2 frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_fisher_f_cumulative_distribution"
func f_quantile(p frac, df1 frac, df2 frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_f_quantile"
func gamma_pdf(x frac, shape frac, scale frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_gamma_pdf"
func gamma_cdf(x frac, shape frac, scale frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_gamma_cdf"
func gamma_quantile(p frac, shape frac, scale frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_gamma_quantile"
func beta_pdf(x frac, alpha frac, beta frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_beta_pdf"
func beta_cdf(x frac, alpha frac, beta frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_beta_cdf"
func beta_quantile(p frac, alpha frac, beta frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_beta_quantile"
func binomial_probability_mass(k int, n int, p frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_binomial_probability_mass"
func binomial_cumulative_distribution(k int, n int, p frac) -> Result<real, mathematics_error.MathError> = "lmx_statistics_binomial_cumulative_distribution"
