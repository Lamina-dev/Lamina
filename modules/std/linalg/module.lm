import std.mathematics_error

type LUFactor = LUFactor(matrix, array<int>)
type QRFactor = QRFactor(matrix, vector)
type EigenResult = EigenResult(matrix, matrix, matrix, matrix)
type SvdResult = SvdResult(matrix, matrix, matrix)

static "liblamina"

func vector(values array<frac>) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_vector_from_array"
func vector_real(values array<real>) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_vector_from_array"
func matrix_real(rows array<array<real>>) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_matrix"
func matrix(rows array<array<frac>>) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_matrix"
func vector_size(value vector) -> int = "lmx_linear_algebra_vector_size"
func element_at(value vector, index int) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_at"
func row_count(value matrix) -> int = "lmx_linear_algebra_row_count"
func column_count(value matrix) -> int = "lmx_linear_algebra_column_count"
func element_at(value matrix, row int, column int) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_element_at"
func dot_product(lhs vector, rhs vector) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_dot_product"
func norm(value vector) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_norm"
func transpose(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_transpose"
func multiply(lhs matrix, rhs matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_multiply"
func matrix_vector_product(value matrix, vector vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_matrix_vector_product"
func determinant(value matrix) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_det"
func inverse(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_inverse"
func trace(value matrix) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_trace"
func rank(value matrix) -> Result<int, mathematics_error.MathError> = "lmx_linear_algebra_rank"
func matrix_norm(value matrix) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_matrix_norm"
func shape(value matrix) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_shape"
func adjoint(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_adjoint"
func solve_left(lhs matrix, rhs matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_solve_left"
func solve_right(lhs matrix, rhs matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_solve_right"
func one_norm(value matrix) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_one_norm"
func infinity_norm(value matrix) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_infinity_norm"
func least_squares(value matrix, rhs vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_least_squares"
func solve_triangular(value matrix, rhs vector, upper bool, unit_diagonal bool) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_solve_triangular"
func cross(lhs vector, rhs vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_cross"
func add(lhs vector, rhs vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_vector_add"
func subtract(lhs vector, rhs vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_vector_subtract"
func multiply_scalar(value vector, scalar frac) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_vector_multiply_scalar"
func power(base vector, exponent vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_power"
func scale(value vector, scalar frac) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_vector_scale"
func identity_matrix(size int) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_identity_matrix"
func diagonal_matrix(diagonal vector) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_diagonal_matrix"
func add(lhs matrix, rhs matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_add"
func subtract(lhs matrix, rhs matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_subtract"
func elementwise_multiply(lhs matrix, rhs matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_elementwise_multiply"
func elementwise_divide(lhs matrix, rhs matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_elementwise_divide"
func multiply_scalar(value matrix, scalar frac) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_multiply_scalar"
func integer_power(value matrix, exponent int) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_integer_power"

func lower_upper_factorization(value matrix) -> Result<LUFactor, mathematics_error.MathError> = "lmx_linear_algebra_lower_upper_factorization"
func solve_with_lower_upper_factorization(factor LUFactor, rhs vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_solve_with_lower_upper_factorization"
func cholesky_factor(value matrix) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_cholesky_factor"
func cholesky_solve(factor matrix, rhs vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_cholesky_solve"
func orthogonal_triangular_factorization(value matrix) -> Result<QRFactor, mathematics_error.MathError> = "lmx_linear_algebra_orthogonal_triangular_factorization"
func solve_with_orthogonal_triangular_factorization(factor QRFactor, rhs vector) -> Result<vector, mathematics_error.MathError> = "lmx_linear_algebra_solve_with_orthogonal_triangular_factorization"
func eigendecomposition(value matrix) -> Result<EigenResult, mathematics_error.MathError> = "lmx_linear_algebra_eigendecomposition"
func singular_value_decomposition(value matrix) -> Result<SvdResult, mathematics_error.MathError> = "lmx_linear_algebra_singular_value_decomposition"
func pseudoinverse(value matrix, tolerance frac) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_pseudoinverse"
func condition_number(value matrix) -> Result<real, mathematics_error.MathError> = "lmx_linear_algebra_condition_number"

func eigen_real_values(value EigenResult) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_eigen_real_values"
func eigen_imag_values(value EigenResult) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_eigen_imag_values"
func eigen_real_vectors(value EigenResult) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_eigen_real_vectors"
func eigen_imag_vectors(value EigenResult) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_eigen_imag_vectors"
func svd_u(value SvdResult) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_svd_u"
func svd_s(value SvdResult) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_svd_s"
func svd_vt(value SvdResult) -> Result<matrix, mathematics_error.MathError> = "lmx_linear_algebra_svd_vt"
