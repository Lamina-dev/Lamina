import std.mathematics_error

static "liblamina"

func create(seed int) -> Result<rng, mathematics_error.MathError> = "lmx_random_create"
func clone(value rng) -> Result<rng, mathematics_error.MathError> = "lmx_random_clone"
func jump(value rng) -> Result<rng, mathematics_error.MathError> = "lmx_random_jump"
func uniform(value rng, lower frac, upper frac) -> Result<real, mathematics_error.MathError> = "lmx_random_uniform"
func normal(value rng, mean frac, stddev frac) -> Result<real, mathematics_error.MathError> = "lmx_random_normal_with_generator"
func normal(mean frac, stddev frac) -> Result<real, mathematics_error.MathError> = "lmx_random_normal"
func exponential(value rng, rate frac) -> Result<real, mathematics_error.MathError> = "lmx_random_exponential"
func integer(value rng, lower int, upper int) -> Result<int, mathematics_error.MathError> = "lmx_random_int"
func vector(value rng, count int, lower frac, upper frac) -> Result<vector, mathematics_error.MathError> = "lmx_random_vector"
func long_jump(value rng) -> Result<rng, mathematics_error.MathError> = "lmx_random_long_jump"
func gamma(value rng, shape frac, scale frac) -> Result<real, mathematics_error.MathError> = "lmx_random_gamma"
func beta(value rng, alpha frac, beta frac) -> Result<real, mathematics_error.MathError> = "lmx_random_beta"
func chi_squared(value rng, degrees_of_freedom frac) -> Result<real, mathematics_error.MathError> = "lmx_random_chi_squared"
func fisher_f(value rng, first_df frac, second_df frac) -> Result<real, mathematics_error.MathError> = "lmx_random_fisher_f"
func student_t(value rng, degrees_of_freedom frac) -> Result<real, mathematics_error.MathError> = "lmx_random_student_t"
func poisson(value rng, lambda frac) -> Result<int, mathematics_error.MathError> = "lmx_random_poisson"
func binomial(value rng, count int, probability frac) -> Result<int, mathematics_error.MathError> = "lmx_random_binomial"
func shuffle(value rng, input vector) -> Result<vector, mathematics_error.MathError> = "lmx_random_shuffle"
func seed(value int) -> Result<bool, mathematics_error.MathError> = "lmx_random_seed"
func random_real() -> Result<real, mathematics_error.MathError> = "lmx_random_random_real"
func random_integer(lower int, upper int) -> Result<int, mathematics_error.MathError> = "lmx_random_random_integer"
func choice(values vector) -> Result<real, mathematics_error.MathError> = "lmx_random_choice"
