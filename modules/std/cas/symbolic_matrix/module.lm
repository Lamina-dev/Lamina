import std.mathematics_error
import std.cas.raw.symbolic_matrix

func from_rows(rows array<array<expr>>) -> expr {
    match symbolic_matrix.from_rows(rows) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func multiply(lhs expr, rhs expr) -> expr {
    match symbolic_matrix.multiply(lhs, rhs) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func determinant(value expr) -> expr {
    match symbolic_matrix.determinant(value) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func inverse(value expr) -> expr {
    match symbolic_matrix.inverse(value) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

