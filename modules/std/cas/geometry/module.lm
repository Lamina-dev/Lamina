import std.mathematics_error
import std.cas.raw.geometry

func gradient(value expr, variables array<text>) -> array<expr> {
    match geometry.gradient(value, variables) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

