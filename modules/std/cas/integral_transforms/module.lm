import std.mathematics_error
import std.cas.raw.integral_transforms

func laplace(value expr, time_variable text, frequency_variable text) -> expr {
    match integral_transforms.laplace(value, time_variable, frequency_variable) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func laplace(value expr, time_variable expr, frequency_variable expr) -> expr {
    match integral_transforms.laplace(value, time_variable, frequency_variable) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func inverse_laplace(value expr, frequency_variable text, time_variable text) -> expr {
    match integral_transforms.inverse_laplace(value, frequency_variable, time_variable) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func inverse_laplace(value expr, frequency_variable expr, time_variable expr) -> expr {
    match integral_transforms.inverse_laplace(value, frequency_variable, time_variable) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
