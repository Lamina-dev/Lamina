import std.mathematics_error
import std.cas.raw.complex_analysis

func residue(value expr, variable text, point expr, order int) -> expr {
    match complex_analysis.residue(value, variable, point, order) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func residue(value expr, variable expr, point expr, order int) -> expr {
    match complex_analysis.residue(value, variable, point, order) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

