import std.mathematics_error
import std.cas.raw.ordinary_differential_equations

func solve_separable(rhs expr, independent text, dependent text) -> expr {
    match ordinary_differential_equations.solve_separable(rhs, independent, dependent) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func solve_separable(rhs expr, independent expr, dependent expr) -> expr {
    match ordinary_differential_equations.solve_separable(rhs, independent, dependent) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

