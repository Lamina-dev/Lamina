func solve(equation expr, variable expr) -> set<expr> {
    match raw.solve(equation, variable) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func roots(value expr, variable text) -> set<expr> {
    match raw.roots(value, variable) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func roots(value expr, variable expr) -> set<expr> {
    match raw.roots(value, variable) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func to_text(value expr) -> text {
    raw.to_text(value)
}

func set_to_array(values set<expr>) -> array<expr> {
    raw.set_to_array(values)
}
