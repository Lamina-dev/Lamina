import std.mathematics_error
import std.cas.raw.series

func laurent(value expr, variable text, center expr, negative_order int, positive_order int) -> expr {
    match series.laurent(value, variable, center, negative_order, positive_order) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func laurent(value expr, variable expr, center expr, negative_order int, positive_order int) -> expr {
    match series.laurent(value, variable, center, negative_order, positive_order) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

