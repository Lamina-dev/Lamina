import std.mathematics_error
import std.cas.raw.equation_solving

func with_assumptions(context assumptions, equation expr, variable text) -> array<expr> {
    match equation_solving.with_assumptions(context, equation, variable) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

func system(equations array<expr>, variables array<text>) -> array<table> {
    match equation_solving.system(equations, variables) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

