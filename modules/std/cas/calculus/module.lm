import std.mathematics_error
import std.cas.raw.calculus

func implicit_differentiate(value expr, independent text, dependent text) -> expr {
    match calculus.implicit_differentiate(value, independent, dependent) {
        Result.Ok(value) => value,
        Result.Err(error) => mathematics_error.raise(error)
    }
}

