import std.mathematics_error

static "liblamina"

func factor(value expr) -> Result<expr, mathematics_error.MathError> = "lmx_cas_factor"
func cancel(value expr) -> Result<expr, mathematics_error.MathError> = "lmx_cas_cancel"
func simplify_trigonometric(value expr) -> Result<expr, mathematics_error.MathError> = "lmx_cas_simplify_trigonometric"
func factor_multivariate(value expr) -> Result<expr, mathematics_error.MathError> = "lmx_cas_factor_multivariate"
func multivariate_greatest_common_divisor(lhs expr, rhs expr) -> Result<expr, mathematics_error.MathError> = "lmx_cas_polynomial_gcd"
func factor_transcendental(value expr, variable text) -> Result<set<expr>, mathematics_error.MathError> = "lmx_cas_factor_transcendental_by_name"
func factor_transcendental(value expr, variable expr) -> Result<set<expr>, mathematics_error.MathError> = "lmx_cas_factor_transcendental_by_symbol"
func polynomial_greatest_common_divisor(lhs expr, rhs expr) -> Result<expr, mathematics_error.MathError> = "lmx_cas_polynomial_gcd"
func polynomial_resultant(lhs expr, rhs expr, variable text) -> Result<expr, mathematics_error.MathError> = "lmx_cas_polynomial_resultant"
