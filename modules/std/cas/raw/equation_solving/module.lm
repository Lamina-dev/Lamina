import std.mathematics_error

type ParametricCase = ParametricCase(expr, array<table>)
type ParametricPiecewise = ParametricPiecewise(array<ParametricCase>)

static "liblamina"

func with_assumptions(context assumptions, equation expr, variable text) -> Result<array<expr>, mathematics_error.MathError> = "lmx_computer_algebra_equation_solving_with_assumptions"
func system(equations array<expr>, variables array<text>) -> Result<array<table>, mathematics_error.MathError> = "lmx_computer_algebra_equation_solving_system_by_names"
func system(equations array<expr>, variables array<expr>) -> Result<array<table>, mathematics_error.MathError> = "lmx_computer_algebra_equation_solving_system_by_symbols"
