import std.mathematics_error

type Line = Line(array<expr>, array<expr>)
type Plane = Plane(array<expr>, expr)

static "liblamina"

func gradient(value expr, variables array<text>) -> Result<array<expr>, mathematics_error.MathError> = "lmx_computer_algebra_calculus_gradient_by_names"
func divergence(field array<expr>, variables array<text>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_calculus_divergence_by_names"
func curl(field array<expr>, variables array<text>) -> Result<array<expr>, mathematics_error.MathError> = "lmx_computer_algebra_calculus_curl_by_names"
func laplacian(value expr, variables array<text>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_calculus_laplacian_by_names"
func jacobian(functions array<expr>, variables array<text>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_calculus_jacobian_by_names"
func hessian(value expr, variables array<text>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_calculus_hessian_by_names"
func volume_revolution_x(value expr, lower expr, upper expr) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_calculus_volume_revolution_x"
func vector_dot(lhs array<expr>, rhs array<expr>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_vector_dot"
func vector_cross(lhs array<expr>, rhs array<expr>) -> Result<array<expr>, mathematics_error.MathError> = "lmx_computer_algebra_geometry_vector_cross"
func line_plane_intersection(point array<expr>, direction array<expr>, normal array<expr>, offset expr) -> Result<array<expr>, mathematics_error.MathError> = "lmx_computer_algebra_geometry_line_plane_intersection"
func metric_inverse(metric expr) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_metric_inverse"
func arc_length_x(value expr, lower expr, upper expr) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_calculus_arc_length_x"
func vector_angle(lhs array<expr>, rhs array<expr>) -> Result<real, mathematics_error.MathError> = "lmx_computer_algebra_geometry_vector_angle"
func point_plane_distance(point array<expr>, normal array<expr>, offset expr) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_point_plane_distance"
func line_from_two_points(lhs array<expr>, rhs array<expr>) -> Result<Line, mathematics_error.MathError> = "lmx_computer_algebra_geometry_line_from_two_points"
func plane_from_three_points(a array<expr>, b array<expr>, c array<expr>) -> Result<Plane, mathematics_error.MathError> = "lmx_computer_algebra_geometry_plane_from_three_points"
func surface_normal(surface expr, variables array<expr>, point array<expr>) -> Result<array<expr>, mathematics_error.MathError> = "lmx_computer_algebra_geometry_surface_normal"
func tangent_plane(surface expr, variables array<expr>, point array<expr>) -> Result<Plane, mathematics_error.MathError> = "lmx_computer_algebra_geometry_tangent_plane"
func directional_derivative(value expr, variables array<expr>, direction array<expr>, order int) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_directional_derivative"
func curve_integral_scalar(value expr, path array<expr>, parameter expr, lower expr, upper expr) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_curve_integral_scalar"
func curve_integral_vector(field array<expr>, path array<expr>, parameter expr, lower expr, upper expr) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_curve_integral_vector"
func surface_integral_scalar(value expr, path array<expr>, u expr, v expr, u_bounds array<expr>, v_bounds array<expr>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_surface_integral_scalar"
func surface_integral_vector(field array<expr>, path array<expr>, u expr, v expr, u_bounds array<expr>, v_bounds array<expr>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_surface_integral_vector"
func greens_theorem(p expr, q expr, variables array<expr>, x_bounds array<expr>, y_bounds array<expr>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_greens_theorem"
func stokes_theorem(field array<expr>, variables array<expr>, path array<expr>, u expr, v expr, u_bounds array<expr>, v_bounds array<expr>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_stokes_theorem"
func divergence_theorem(field array<expr>, variables array<expr>, x_bounds array<expr>, y_bounds array<expr>, z_bounds array<expr>) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_divergence_theorem"
func find_extrema(value expr, variables array<expr>) -> Result<array<table>, mathematics_error.MathError> = "lmx_computer_algebra_geometry_find_extrema"
func lagrange_multipliers(value expr, constraints array<expr>, variables array<expr>) -> Result<array<table>, mathematics_error.MathError> = "lmx_computer_algebra_geometry_lagrange_multipliers"
func christoffel_first_kind(metric expr, variables array<expr>, k int, i int, j int) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_christoffel_first"
func christoffel_second_kind(metric expr, inverse expr, variables array<expr>, k int, i int, j int) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_christoffel_second"
func riemann_curvature_tensor(metric expr, variables array<expr>, rho int, sigma int, mu int, nu int) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_riemann"
func exterior_derivative(coefficients array<expr>, degree int, variables array<expr>) -> Result<array<expr>, mathematics_error.MathError> = "lmx_computer_algebra_geometry_exterior_derivative"
func lie_derivative(value expr, field array<expr>, variables array<expr>, order int) -> Result<expr, mathematics_error.MathError> = "lmx_computer_algebra_geometry_lie_derivative"
