static "Lamina"

func printf(fmt text, ...) -> int = "printf"
func sleep(s int) -> null = "sleep"

var i = 5
loop {
    printf("Hello Lamina %lld\n", i)
    var i2 = 5
    loop {
        printf("Lamina %lld\n", i)
        i2 = i2 - 1
        if i2 == 0 {
            break
        }
    }

    i = i - 1
    if i == 0 {
        break
    }
}

