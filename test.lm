static "laminaCore"
import std.io
func printf(fmt text, ...) -> int = "printf"


func println_int(n int, say text) {
    printf("%lld, %s\n", n, say)
    n
}
func foo(a int) {
    a + a
}

let foo_ref = foo
printf("%lld\n",
    4
    |> foo_ref
    |> println_int("say1")
    |> foo_ref
    |> foo_ref
    |> println_int("say2")
)

printf("%.1f\n", io.bar()(5))
